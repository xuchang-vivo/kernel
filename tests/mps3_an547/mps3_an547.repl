sysbus:
    init:
        Tag <0x51400000 0x100000> "eth0"
        Tag <0x51100000 0x1000> "gpio0"
        Tag <0x51101000 0x1000> "gpio1"
        Tag <0x51102000 0x1000> "gpio2"
        Tag <0x51103000 0x1000> "gpio3"
        Tag <0x59200000 0x1000> "i2c_touch"
        Tag <0x59201000 0x1000> "i2c_audio_conf"
        Tag <0x59202000 0x1000> "spi_adc"
        Tag <0x59203000 0x1000> "spi_shield0"
        Tag <0x59204000 0x1000> "spi_shield1"
        Tag <0x59205000 0x1000> "i2c_shield0"
        Tag <0x59206000 0x1000> "i2c_shield1"
        Tag <0x59208000 0x1000> "i2c_ddr4_eeprom"
        Tag <0x59308000 0x1000> "uart5"
        Tag <0xe000ed90 0x40> "mpu"
        Tag <0xe000e010 0x10> "systick"
        Tag <0x59302000 0x4> "gpio_led0"
        Tag <0x59302008 0x4> "gpio_button"
        Tag <0x5930204c 0x4> "gpio_misc"

itcm: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x80000

sram: Memory.MappedMemory @ sysbus 0x21000000
    size: 0x400000

isram: Memory.MappedMemory @ sysbus 0x01000000
    size: 0x200000

ddr4: Memory.MappedMemory @ sysbus 0x60000000
    size: 0x10000000

// autogenerated

uart0: UART.CMSDK_APB_UART @ sysbus 0x59303000
    TxInterrupt->nvic0@34
    RxInterrupt->nvic0@33

uart1: UART.CMSDK_APB_UART @ sysbus 0x59304000
    TxInterrupt->nvic0@36
    RxInterrupt->nvic0@35

uart2: UART.CMSDK_APB_UART @ sysbus 0x59305000
    TxInterrupt->nvic0@38
    RxInterrupt->nvic0@37

uart3: UART.CMSDK_APB_UART @ sysbus 0x59306000
    TxInterrupt->nvic0@40
    RxInterrupt->nvic0@39

uart4: UART.CMSDK_APB_UART @ sysbus 0x59307000
    TxInterrupt->nvic0@42
    RxInterrupt->nvic0@41

nvic0: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu0 }
}
    -> cpu0@0
    systickFrequency: 25000000

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m55"
    nvic: nvic0

// arm,mps3-an547 overlay

// cortex-m overlay

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 72000000
